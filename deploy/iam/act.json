{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RollbackOneService",
      "Effect": "Allow",
      "Action": ["ecs:UpdateService", "ecs:DescribeServices"],
      "Resource": "arn:aws:ecs:*:*:service/store/*",
      "Condition": {
        "StringLike": {
          "aws:RequestTag/IncidentId": "*",
          "aws:RequestTag/PlanHash": "*"
        }
      }
    }
  ]
}
