{
  "name": "sentinel",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "description": "Sentinel — agentic SRE control plane for AWS and any observability stack.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:prepare": "node scripts/dev/prepare.mjs",
    "dev:connect-local": "tsx scripts/dev/connect-local.ts",
    "dev:observe": "docker compose --env-file .local/compose.env -p sentinel -f compose.observe.yml up -d --build workload prometheus blackbox loki tempo alloy grafana ntfy && npm run dev:wait",
    "dev:doctor": "node scripts/dev/doctor.mjs",
    "dev:prepare-auth": "SENTINEL_PUBLIC_URL=http://localhost:3010 node scripts/dev/prepare-keycloak.mjs",
    "dev:wait": "node scripts/dev/wait.mjs",
    "scenario:healthy": "node scripts/scenarios/traffic.mjs healthy",
    "scenario:degradation": "node scripts/scenarios/traffic.mjs degradation",
    "scenario:recovery": "node scripts/scenarios/traffic.mjs recovery",
    "test": "vitest run",
    "test:telemetry": "TEST_LIVE_TELEMETRY=true vitest run tests/live/telemetry.live.test.ts",
    "test:aws": "tsx scripts/verify-ecs.ts",
    "db:provision": "node scripts/run.mjs provision",
    "db:migrate": "node scripts/run.mjs migrate",
    "demo": "tsx apps/cli/src/main.ts replay",
    "validate": "tsx apps/cli/src/main.ts catalog",
    "dev:api": "node scripts/run.mjs api",
    "dev:demo-api": "node scripts/run.mjs demo",
    "dev:worker-read": "node scripts/run.mjs worker",
    "dev:console": "node scripts/run.mjs console dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:showcase": "node apps/showcase/build.mjs",
    "demo:showcase": "npm run build:showcase && node apps/showcase/serve.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
