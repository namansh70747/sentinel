{
  "name": "sentinel",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "description": "Sentinel \u2014 agentic SRE control plane for AWS and any observability stack.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:aws": "tsx scripts/verify-ecs.ts",
    "db:provision": "node scripts/run.mjs provision",
    "db:migrate": "node scripts/run.mjs migrate",
    "demo": "tsx apps/cli/src/main.ts replay",
    "validate": "tsx apps/cli/src/main.ts catalog",
    "dev:api": "node scripts/run.mjs api",
    "dev:demo-api": "node scripts/run.mjs demo",
    "dev:worker-read": "node scripts/run.mjs worker",
    "dev:console": "node scripts/run.mjs console dev",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
