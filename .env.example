# Sentinel production defaults to advise. Demo replay requires an explicit demo process.
# Fill only what you want to point at a real account. Default mode is advise:
# the process will not call a write API.

# advise | act
SENTINEL_MODE=advise
SENTINEL_PORT=8787
SENTINEL_WEBHOOK_SECRET=change-me

# Operator console
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_DEMO_API_URL=http://localhost:8790
# Console listens on 3010 because 3000 is often already taken.

# Grafana (or any Prometheus-compatible URL the metrics connector uses)
GRAFANA_URL=
GRAFANA_TOKEN=
GRAFANA_PROMETHEUS_DATASOURCE_UID=
GRAFANA_LOKI_DATASOURCE_UID=
GRAFANA_TEMPO_DATASOURCE_UID=

# AWS read role. The act role is assumed only inside a signed playbook.
AWS_REGION=us-east-1
AWS_PROFILE=
SENTINEL_READ_ROLE_ARN=
SENTINEL_ACT_ROLE_ARN=

# Bedrock. Leave blank to keep the deterministic ranker (no model spend).
BEDROCK_REGION=us-east-1
BEDROCK_RANK_MODEL_ID=
BEDROCK_SUMMARY_MODEL_ID=

# Durable production foundation
DATABASE_URL=
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=default

# Chat and paging. Unused until you set them. Sentinel never posts without these.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
PAGERDUTY_API_TOKEN=
PAGERDUTY_ROUTING_KEY=

# Status and tickets
STATUSPAGE_API_KEY=
STATUSPAGE_PAGE_ID=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
LINEAR_API_KEY=

# Source
GITHUB_TOKEN=


# LLM traces for the ranker, if you self-host Langfuse
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Opt-in demo only; leave false for production
SENTINEL_DEMO=false
# Optional Prometheus bearer token; console server only
PROMETHEUS_TOKEN=

# Organization OpenID Connect (server-only)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SENTINEL_PUBLIC_URL=http://localhost:3010

PROMETHEUS_URL=
# Local durable Compose passwords; URL-safe values of at least 16 characters
SENTINEL_DATABASE_ADMIN_PASSWORD=
SENTINEL_DATABASE_PASSWORD=

# Explicit workspace owner of server-scoped provider credentials
SENTINEL_CONFIG_WORKSPACE_ID=
