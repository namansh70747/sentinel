# Sentinel production defaults to advise. Demo replay requires an explicit demo process.
# Fill only what you want to point at a real account. Default mode is advise:
# the process will not call a write API.

# advise | act
SENTINEL_MODE=advise
SENTINEL_PORT=8787
SENTINEL_WEBHOOK_SECRET=change-me

# Operator console
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_DEMO_API_URL=http://localhost:8790
# Console listens on 3010 because 3000 is often already taken.

# Grafana (or any Prometheus-compatible URL the metrics connector uses)
GRAFANA_URL=
GRAFANA_TOKEN=
GRAFANA_PROMETHEUS_DATASOURCE_UID=
GRAFANA_LOKI_DATASOURCE_UID=
GRAFANA_TEMPO_DATASOURCE_UID=

# AWS read role. The act role is assumed only inside a signed playbook.
AWS_REGION=us-east-1
AWS_PROFILE=
SENTINEL_READ_ROLE_ARN=
SENTINEL_ACT_ROLE_ARN=

# Bedrock. Leave blank to keep the deterministic ranker (no model spend).
BEDROCK_REGION=us-east-1
BEDROCK_RANK_MODEL_ID=
BEDROCK_SUMMARY_MODEL_ID=
# Enable hosted shadow ranking only for approved workspace UUIDs and a dedicated inference role.
SENTINEL_BEDROCK_ADVISORY_WORKSPACES=
SENTINEL_BEDROCK_ADVISORY_ROLE_ARN=

# Durable production foundation
DATABASE_URL=
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=default

# Chat and paging. Unused until you set them. Sentinel never posts without these.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
PAGERDUTY_API_TOKEN=
PAGERDUTY_ROUTING_KEY=

# Status and tickets
STATUSPAGE_API_KEY=
STATUSPAGE_PAGE_ID=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
LINEAR_API_KEY=

# Source
GITHUB_TOKEN=


# LLM traces for the ranker, if you self-host Langfuse
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Opt-in demo only; leave false for production
SENTINEL_DEMO=false
# Optional Prometheus bearer token; console server only
PROMETHEUS_TOKEN=

# Organization OpenID Connect (server-only)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SENTINEL_PUBLIC_URL=http://localhost:3010

PROMETHEUS_URL=
# Local durable Compose passwords; URL-safe values of at least 16 characters
SENTINEL_DATABASE_ADMIN_PASSWORD=
SENTINEL_DATABASE_PASSWORD=

# Explicit workspace owner of server-scoped provider credentials
SENTINEL_CONFIG_WORKSPACE_ID=

# off | live. Fresh investigations require an approved ECS binding.
SENTINEL_ECS_MODE=off
LOKI_URL=http://127.0.0.1:3100
TEMPO_URL=http://127.0.0.1:3200
NTFY_URL=http://127.0.0.1:8091
NTFY_TOPIC=
SENTINEL_EGRESS_ALLOWLIST=127.0.0.1,localhost,prometheus,loki,tempo,ntfy,api.github.com
SENTINEL_COVERAGE_QUERY=(time() - max(workload_process_start_seconds))
SENTINEL_GRAFANA_ENDPOINT_ID=
GF_SECURITY_ADMIN_PASSWORD=
KEYCLOAK_OPERATOR_PASSWORD=
# Fill these only when a sandbox role exists. Do not commit values.
AWS_REGION=
SENTINEL_AWS_ACCOUNT_ID=
SENTINEL_READ_ROLE_ARN=
SENTINEL_ECS_SERVICE_ARN=
# Optional: activated billing tag and a supported protected resource in the ECS account and region.
SENTINEL_AWS_COST_SCOPE=
SENTINEL_AWS_SERVICE_PROFILE=
SENTINEL_COST_TAG_KEY=
SENTINEL_COST_TAG_VALUE=
SENTINEL_BACKUP_RESOURCE_ARN=
SENTINEL_CLOUDWATCH_LOG_GROUP=
SENTINEL_CLOUDWATCH_LOG_STREAM_PREFIX=
GITHUB_TOKEN=
GITHUB_REPOSITORY=
OLLAMA_URL=
OLLAMA_MODEL=
# Optional local endpoint for ranking otherwise comparable Slack next steps.
SENTINEL_RECOMMENDATION_OLLAMA_URL=

# Optional hosted advisory, used only by the advisory evaluator.
GEMINI_API_KEY=
NVIDIA_API_KEY=
SENTINEL_ADVISORY_PROVIDER=
SENTINEL_HOSTED_ADVISORY_WORKSPACES=
