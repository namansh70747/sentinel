{
  "uid": "sentinel-advisory",
  "title": "Sentinel advisory reliability",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Advisory evaluations in the preceding hour",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sentinel_advisory_evaluations_last_hour",
          "legendFormat": "{{provider}} \u00b7 {{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Mean model evaluation time in seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sentinel_advisory_mean_evaluation_seconds_last_hour",
          "legendFormat": "{{provider}} \u00b7 {{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Metrics scrape availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"sentinel-advisory\"}",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-prometheus"
          }
        }
      ]
    }
  ]
}
